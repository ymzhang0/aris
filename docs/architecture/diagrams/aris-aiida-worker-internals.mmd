    classDef aiida fill:#f3efff,stroke:#8872bd,color:#241d38;
    class UI,REACT client;
    class API,CHAT,AGENT,CAP,OWNER aris;
    class STDIO,DISPATCH,SERVICES,EXEC worker;
    class PROFILE,ORM,ENGINE,REMOTE aiida;
