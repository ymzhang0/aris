%%{init: {"flowchart": {"curve": "basis", "nodeSpacing": 18, "rankSpacing": 28, "diagramPadding": 6}, "themeVariables": {"fontSize": "14px"}}}%%
flowchart LR
    subgraph CLIENT["CLIENT · shared React UI"]
        UI["Browser / ARIS.app"]
        REACT["React frontend<br/>chat · compute · provenance"]
        UI --> REACT
    end

    subgraph ARIS["ARIS CONTROL PLANE · API :8000"]
        API["FastAPI + SPA<br/>src/app_api.py"]
        CHAT["Chat application<br/>session · state machine · approval"]
        AGENT["Agent runtime<br/>Pydantic AI"]
        CAP["AiiDA capability adapter<br/>protocol-first request mapping"]
        OWNER["ProjectWorkerProcessManager<br/>project + Python + profile key<br/>verify · restart · stop"]
        API --> CHAT --> AGENT --> CAP --> OWNER
    end

    subgraph WORKER["PROJECT PYTHON WORKER · no port"]
        STDIO["stdio loop<br/>newline-delimited JSON-RPC 2.0"]
        DISPATCH["AiiDAWorkerService<br/>validated method + params<br/>structured domain errors"]
        SERVICES["Project-local capabilities<br/>plugins · WorkChains · submission<br/>process · group · node · data<br/>execution · registry"]
        EXEC["DynamicExecutionRuntime<br/>same worker Python + workspace<br/>isolated script subprocess"]
        STDIO --> DISPATCH --> SERVICES --> EXEC
    end

    subgraph AIIDA["AiiDA + COMPUTE"]
        PROFILE["Selected AiiDA profile"]
        ORM["ORM · storage · provenance"]
        ENGINE["engine / daemon"]
        REMOTE["local or SSH scheduler"]
        PROFILE --> ORM --> ENGINE --> REMOTE
    end

    REACT <-->|"REST / AG-UI"| API
    OWNER <-->|"stdin/stdout<br/>one request at a time"| STDIO
    SERVICES <-->|"direct Python API"| PROFILE

    classDef client fill:#eef4ff,stroke:#7393c2,color:#172033;
    classDef aris fill:#eaf8f2,stroke:#5b9b7e,color:#163128;
